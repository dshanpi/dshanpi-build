set -eu
export DEBIAN_FRONTEND=noninteractive
opts=(-o Dir::Etc::sourcelist=/etc/apt/sources.list.d/dshanpi.sources -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 -o Acquire::http::No-Cache=true -o Acquire::https::No-Cache=true -o Acquire::https::Timeout=30)
cat /etc/apt/sources.list.d/dshanpi.sources
apt-get "${opts[@]}" update
apt-cache "${opts[@]}" policy dshanpi-a1-axcl-8g dshanpi-a1-axcl-16g
apt-get "${opts[@]}" --reinstall install -y dshanpi-a1-axcl-8g=3.16.0+dshanpi.2026.10.15.3
systemctl enable --now dshanpi-axcl.service
runuser -u baiwen -- axcl-smi
apt-get check
