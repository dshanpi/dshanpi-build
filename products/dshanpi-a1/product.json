{
  "schema_version": 1,
  "product": "dshanpi-a1",
  "distribution": "ubuntu",
  "codename": "noble",
  "testing_suite": "noble-testing",
  "component": "dshanpi-a1",
  "architectures": ["arm64", "all"],
  "sources": {
    "armbianos": "https://github.com/dshanpi/ArmBianOS.git",
    "dspi_config": "https://github.com/dshanpi/dspi-config.git"
  },
  "armbian": {
    "board": "dshanpi-a1",
    "branch": "vendor",
    "release": "noble",
    "desktop_environment": "gnome",
    "desktop_config": "config_base",
    "boot_fdt_file": "rockchip/rk3576-100ask-dshanpi-a1.dtb"
  },
  "package_search_paths": [
    "output/debs",
    "output/dshanpi-packages",
    "debs/mpp",
    "debs/rga",
    "debs/gsteamer"
  ],
  "package_adapters": ["rkaiq-reviewed"],
  "common_packages": [
    "dshanpi-archive-keyring",
    "dspi-config"
  ],
  "required_packages": [
    {"name": "base-files", "arch": "arm64"},
    {"name": "armbian-bsp-cli-dshanpi-a1-vendor", "arch": "arm64"},
    {"name": "armbian-bsp-desktop-dshanpi-a1-vendor", "arch": "arm64"},
    {"name": "linux-image-vendor-rk35xx", "arch": "arm64"},
    {"name": "linux-dtb-vendor-rk35xx", "arch": "arm64"},
    {"name": "linux-headers-vendor-rk35xx", "arch": "arm64"},
    {"name": "camera-engine-rkaiq", "arch": "arm64"},
    {"name": "gstreamer1.0-rockchip1", "arch": "arm64"},
    {"name": "librockchip-mpp1", "arch": "arm64"},
    {"name": "librockchip-mpp-dev", "arch": "arm64"},
    {"name": "librockchip-vpu0", "arch": "arm64"},
    {"name": "rockchip-mpp-demos", "arch": "arm64"},
    {"name": "librga2", "arch": "arm64"},
    {"name": "librga-dev", "arch": "arm64"},
    {"name": "dshanpi-archive-keyring", "arch": "all"},
    {"name": "dshanpi-a1-repository", "arch": "all"},
    {"name": "dspi-config", "arch": "all"}
  ],
  "release_meta": {
    "core": "dshanpi-a1-release-core",
    "desktop": "dshanpi-a1-release-desktop",
    "desktop_only_dependencies": ["armbian-bsp-desktop-dshanpi-a1-vendor"]
  },
  "forbidden_package_patterns": [
    "^linux-u-boot-",
    "^linux-libc-dev-"
  ]
}
